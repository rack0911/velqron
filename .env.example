# Velqron Environment Configuration
# Copy this file to .env and fill in your values

# NVIDIA API Key (required for cloud LLM reasoning mode)
# Get your key from: https://build.nvidia.com/
VELQRON_NVIDIA_API_KEY=your_nvidia_api_key_here

# Hybrid Intelligence Split (Testing vs Commercial)
# Use "SIMULATED" for dev/testing and "PHYSICAL" for pilot deployment
VELQRON_DATA_SOURCE=SIMULATED

# Reasoning Mode: "Local Only" (Ollama), "Cloud Only" (NVIDIA), or "Local Priority" (Hybrid)
VELQRON_LLM_MODE=Local Priority
